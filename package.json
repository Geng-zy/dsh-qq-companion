{
  "name": "dsh-qq-companion",
  "version": "1.9.0",
  "description": "给 dsh（DeepSeek Harness）接个人 QQ 号的陪伴型通道插件：OneBot 11 / NapCat，一句一条、私聊与群聊权限隔离、记忆与日记、主动聊天、定期换新会话、运行期群白名单，状态文件原子写、QQ 在线监视。基于 mario841859784/dsh-onebot（BSD-3）。",
  "keywords": [
    "dsh",
    "onebot",
    "onebot11",
    "qq",
    "qq-bot",
    "qqbot",
    "napcat",
    "lagrange",
    "llonebot",
    "go-cqhttp",
    "deepseek",
    "deepseek-harness",
    "harness",
    "bridge",
    "chatbot",
    "companion",
    "ai-companion",
    "memory",
    "proactive"
  ],
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./settings-remote": "./lib/settings-remote.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/*.bak-*",
    "cordis.patch.yml",
    "THIRD-PARTY-NOTICES.md",
    "docs"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geng-zy/dsh-qq-companion.git"
  },
  "homepage": "https://github.com/Geng-zy/dsh-qq-companion#readme",
  "bugs": {
    "url": "https://github.com/Geng-zy/dsh-qq-companion/issues"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "qq_send_image",
        "qq_send_voice",
        "qq_send_video",
        "qq_send_file",
        "qq_send_forward",
        "qq_napcat_api",
        "qq_group_history"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "schemastery": "^3.18.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "schemastery": "^3.18.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "coverage": "vitest run --coverage",
    "docs:config": "node scripts/gen-config-doc.mjs"
  },
  "author": "Geng-zy",
  "contributors": [
    "mario841859784 (original dsh-onebot)"
  ]
}
